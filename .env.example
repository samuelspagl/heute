NUXT_APP_URL=https://heute.example.net
NUXT_APP_SECRET=
NUXT_OIDC_ISSUER=https://id.example.net
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
NUXT_POCKET_ID_API_KEY=
NUXT_FAMILY_GROUP=family
NUXT_ADMIN_GROUP=heute-admin

NUXT_WEATHER_PLACE=
NUXT_WEATHER_LATITUDE=
NUXT_WEATHER_LONGITUDE=
NUXT_WEATHER_TIMEZONE=Europe/Berlin

NUXT_NEXTCLOUD_URL=
NUXT_NEXTCLOUD_ENCRYPTION_KEY=

# JSON list of direct HTTPS feed URLs
NUXT_RSS_FEEDS=[]

# Home Assistant (calendar): fixed HTTP(S) base address without user info/query/fragment
NUXT_HA_URL=
# Long-lived HA access token, only in .env/deployment secrets
NUXT_HA_TOKEN=
# Optional: upper bound of allowed calendars (calendar.[a-z0-9_]+), empty = all HA calendars.
# The per-user selection happens in the widget settings.
NUXT_HA_CALENDAR_IDS=
# Time limit per HA request in milliseconds (1000–30000)
NUXT_HA_REQUEST_TIMEOUT_MS=10000
# Cache duration per calendar in seconds (30–300)
NUXT_HA_CACHE_TTL_SECONDS=90
# Display timezone of events as an IANA zone
NUXT_HA_CALENDAR_TIMEZONE=Europe/Berlin
